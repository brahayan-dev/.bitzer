---
extends: default

ignore: |
  systems/life/vars
  systems/linux/vars

rules:
  line-length: disable
  truthy: disable
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
